#!/usr/bin/env bash
#
# agentic - multi-provider CLI account manager for Codex, Cursor Agent CLI and
# Claude Code.

set -eu

self="$0"
guard=0
while [ -L "$self" ]; do
  guard=$((guard + 1))
  [ "$guard" -gt 40 ] && { echo "error: symlink loop resolving $0" >&2; exit 1; }
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(dirname "$self")/$link" ;;
  esac
done
here="$(cd "$(dirname "$self")" && pwd -P)"
AGENTIC_ROOT="$(cd "$here/.." && pwd -P)"

# shellcheck source=../lib/common.sh
. "$here/../lib/common.sh"
# shellcheck source=../lib/store.sh
. "$here/../lib/store.sh"
# shellcheck source=../lib/provider.sh
. "$here/../lib/provider.sh"
# shellcheck source=../lib/switch.sh
. "$here/../lib/switch.sh"
# shellcheck source=../lib/migrate.sh
. "$here/../lib/migrate.sh"
# shellcheck source=../lib/commands.sh
. "$here/../lib/commands.sh"
# shellcheck source=../lib/rc.sh
. "$here/../lib/rc.sh"

# Print <provider>'s accounts. Human output marks the active (or, in env mode,
# selected) account with " *" and tags the default-home record.
print_accounts() {
  local provider="$1" names="$2" indent="$3" selected="" default="" name suffix
  if [ "$names" -eq 0 ]; then
    load_provider "$provider"
    if provider_env_mode; then
      selected=$(env_selected "$provider")
      default=$(env_default_account "$provider")
    else
      selected=$(get_active "$provider")
    fi
  fi
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    suffix=""
    if [ "$names" -eq 0 ]; then
      [ "$name" != "$default" ] || suffix=" ($(provider_home_label))"
      [ "$name" != "$selected" ] || suffix="$suffix *"
    fi
    printf '%s%s%s\n' "$indent" "$name" "$suffix"
  done < <(list_accounts "$provider")
}

cmd_list() {
  _cl_names=0
  _cl_provider=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --names) _cl_names=1 ;;
      *)
        [ -z "$_cl_provider" ] || die "list takes at most one provider"
        _cl_provider="$1"
        ;;
    esac
    shift
  done

  if [ -n "$_cl_provider" ]; then
    validate_provider "$_cl_provider"
    print_accounts "$_cl_provider" "$_cl_names" ""
    return 0
  fi

  for _cl_provider in $PROVIDER_LIST; do
    if [ "$_cl_names" -eq 1 ]; then
      print_accounts "$_cl_provider" 1 ""
    else
      printf '%s:\n' "$_cl_provider"
      print_accounts "$_cl_provider" 0 "  "
    fi
  done
}

cmd_which() {
  [ $# -eq 1 ] || die "usage: agentic which <provider>"
  load_provider "$1"
  if provider_env_mode; then
    _cw_active=$(env_selected "$1")
    printf '%s\n' "${_cw_active:-default ($(provider_home_label))}"
    return 0
  fi
  _cw_active=$(get_active "$1")
  if [ -n "$_cw_active" ]; then
    printf '%s\n' "$_cw_active"
  else
    info "no account is active for $1"
  fi
}

cmd_login() {
  parse_account_args login "$@"
  local provider="$ARG_PROVIDER" name="$ARG_NAME" dir created=1
  load_provider "$provider"
  if has_flag --existing && ! provider_env_mode; then
    die "--existing works only for providers that keep their own login (claude)"
  fi

  dir=$(account_dir "$provider" "$name")
  if [ -d "$dir" ]; then
    has_flag --force || die "account '$name' already exists - pass --force to replace it"
    created=0
  fi

  ensure_account_dir "$provider" "$name"
  if has_flag --existing; then
    env_register_default "$provider" "$name" "$created"
  else
    live_login "$provider" "$name" "$created"
  fi
}

cmd_use() {
  parse_account_args use "$@"
  local provider="$ARG_PROVIDER" name="$ARG_NAME" force=0
  has_flag --force && force=1
  [ -d "$(account_dir "$provider" "$name")" ] || die "no such account: $name"
  load_provider "$provider"
  live_switch "$provider" "$name" "$force"
}

cmd_relogin() {
  parse_account_args relogin "$@"
  local provider="$ARG_PROVIDER" name="$ARG_NAME"
  [ -d "$(account_dir "$provider" "$name")" ] || die "no such account: $name"
  cmd_login "$provider" "$name" --force
}

auth_is_parseable() {
  if command -v jq >/dev/null 2>&1; then
    jq -e . "$1" >/dev/null 2>&1
    return
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$1" >/dev/null 2>&1
    return
  fi
  die "check requires jq or python3 to validate JSON"
}

cmd_check() {
  parse_account_args check "$@"
  local provider="$ARG_PROVIDER" name="$ARG_NAME" deep=0 active auth
  has_flag --deep && deep=1

  load_provider "$provider"
  if provider_env_mode; then
    provider_status "$name" && return 0
    warn "$provider: '$name' is not logged in"
    return 1
  fi
  if [ "$deep" -eq 1 ] && provider_status_needs_active; then
    active=$(get_active "$provider")
    [ "$name" = "$active" ] ||
      die "$provider deep check works only on the active account ('$active'); run 'agentic use $provider $name' first"
  fi
  auth=$(provider_auth_artifact "$name")
  [ -f "$auth" ] || die "'$name' has no $(basename "$auth")"

  if auth_is_parseable "$auth"; then
    info "structure: valid"
  else
    warn "structure: invalid JSON"
    return 1
  fi

  if [ "$deep" -eq 1 ]; then
    if provider_status "$name"; then
      info "$provider: ok"
    else
      warn "$provider: status failed"
      return 1
    fi
  fi
}

cmd_repair() {
  _cr_provider=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) die "unknown option for repair: $1" ;;
      *)
        validate_provider "$1"
        [ -z "$_cr_provider" ] || die "repair takes at most one provider"
        _cr_provider="$1"
        ;;
    esac
    shift
  done

  for _cr_each in ${_cr_provider:-$PROVIDER_LIST}; do
    load_provider "$_cr_each"
    # Repairing every provider skips the ones with no live auth.
    [ -z "$_cr_provider" ] && provider_env_mode && continue
    live_repair "$_cr_each"
  done
}

cmd_rm() {
  parse_account_args rm "$@"
  local provider="$ARG_PROVIDER" name="$ARG_NAME" dir reply
  dir=$(account_dir "$provider" "$name")
  [ -d "$dir" ] || die "no such account: $name"
  load_provider "$provider"

  if ! has_flag --yes; then
    if [ -f "$dir/default-dir" ]; then
      printf "forget account '%s'? %s and its login are kept [y/N] " "$name" "$(provider_home_label)"
    else
      printf "delete account '%s' and its saved credential? [y/N] " "$name"
    fi
    read -r reply || reply=""
    case "$reply" in
      y|Y|yes|YES) ;;
      *) info "cancelled"; return 0 ;;
    esac
  fi

  live_detach "$provider" "$name"
  rm -rf "$dir"
  info "removed $name"
}

cmd_restore() {
  [ $# -eq 1 ] || die "usage: agentic restore <provider>"
  validate_provider "$1"
  load_provider "$1"
  live_restore "$1"
}

cmd_run() {
  parse_account_args run "$@"
  local provider="$ARG_PROVIDER" name="$ARG_NAME" env
  [ -d "$(account_dir "$provider" "$name")" ] || die "no such account: $name"
  load_provider "$provider"

  env=$(provider_run_env "$name") || exit 1
  provider_export_env "$env"

  exec "$(provider_cli_bin)" ${ARG_REST[@]+"${ARG_REST[@]}"}
}

# --------------------------------------------------------------------------
# shell-init - add or remove the shell integration
# --------------------------------------------------------------------------

shell_snippet_path() {
  printf '%s\n' "$AGENTIC_ROOT/shell/agentic.sh"
}

cmd_shell_init() {
  parse_flags shell-init "$@"
  local rcfile="$ARG_RC"

  if has_flag --print; then
    shell_snippet_path
    return 0
  fi

  [ -n "$rcfile" ] || rcfile=$(default_rcfile)

  if has_flag --remove; then
    rc_remove "$rcfile"
  else
    local snippet
    snippet=$(shell_snippet_path)
    [ -f "$snippet" ] || die "cannot find the shell snippet at $snippet"
    rc_install "$rcfile" "$snippet"
  fi
}

[ $# -gt 0 ] || { usage; exit 1; }

verb="$1"
shift
case "$verb" in
  help|-h|--help) usage ;;
  --version|-V)   print_version agentic ;;
  __complete)     complete_words "$@" ;;
  *)
    command_exists "$verb" || die "unknown command: $verb (try 'agentic --help')"
    "cmd_$(printf %s "$verb" | tr - _)" "$@"
    ;;
esac
