#!/usr/bin/env bash
#
# agentic - multi-provider CLI account manager for Codex and Cursor Agent CLI.

set -eu

self="$0"
guard=0
while [ -L "$self" ]; do
  guard=$((guard + 1))
  [ "$guard" -gt 40 ] && { echo "error: symlink loop resolving $0" >&2; exit 1; }
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *)  self="$(dirname "$self")/$link" ;;
  esac
done
here="$(cd "$(dirname "$self")" && pwd -P)"
AGENTIC_ROOT="$(cd "$here/.." && pwd -P)"

# shellcheck source=../lib/common.sh
. "$here/../lib/common.sh"
# shellcheck source=../lib/store.sh
. "$here/../lib/store.sh"
# shellcheck source=../lib/provider.sh
. "$here/../lib/provider.sh"
# shellcheck source=../lib/switch.sh
. "$here/../lib/switch.sh"
# shellcheck source=../lib/migrate.sh
. "$here/../lib/migrate.sh"

usage() {
  cat <<EOF
${C_BOLD}agentic${C_RESET} - multi-provider CLI account manager

${C_BOLD}USAGE${C_RESET}
  agentic <verb> <provider> <name> [options]
  agentic shell-init [--print|--remove] [--rc FILE]

${C_BOLD}COMMANDS${C_RESET}
  login    <provider> <name> [--force]       Sign in and save an account
  relogin  <provider> <name>                 Sign in again to an account
  use      <provider> <name> [--force]       Make an account active
  run      <provider> <name> [--] <args...>  Run a CLI with an account
  which    <provider>                        Print the active account
  list     [<provider>] [--names]            List saved accounts
  check    <provider> <name> [--deep]        Check account credentials
  repair   [<provider>]                      Repair replaced live auth
  rm       <provider> <name> [--yes]         Delete an account
  restore  <provider>                        Restore backed-up live auth
  migrate                                   Copy codex-accounts data into agentic
  shell-init [--remove|--print] [--rc FILE] Install shell wrappers

${C_BOLD}GLOBAL OPTIONS${C_RESET}
  --help, -h     Show this help
  --version, -V  Print the version

Version $AGENTIC_VERSION
EOF
}

cmd_list() {
  _cl_names=0
  _cl_provider=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --names) _cl_names=1 ;;
      *)
        [ -z "$_cl_provider" ] || die "list takes at most one provider"
        _cl_provider="$1"
        ;;
    esac
    shift
  done

  if [ -z "$_cl_provider" ]; then
    for _cl_provider in $PROVIDER_LIST; do
      _cl_accounts=$(list_accounts "$_cl_provider")
      if [ "$_cl_names" -eq 0 ]; then
        printf '%s:\n' "$_cl_provider"
      fi
      if [ -n "$_cl_accounts" ]; then
        echo "$_cl_accounts" | while IFS= read -r _cl_name; do
          [ -n "$_cl_name" ] || continue
          if [ "$_cl_names" -eq 1 ]; then
            printf '%s\n' "$_cl_name"
          else
            printf '  %s\n' "$_cl_name"
          fi
        done
      fi
    done
    return 0
  fi

  validate_provider "$_cl_provider"
  list_accounts "$_cl_provider"
}

cmd_which() {
  [ $# -eq 1 ] || die "usage: agentic which <provider>"
  validate_provider "$1"
  _cw_active=$(get_active "$1")
  if [ -n "$_cw_active" ]; then
    printf '%s\n' "$_cw_active"
  else
    info "no account is active for $1"
  fi
}

cmd_login() {
  _cl_provider="${1:-}"
  _cl_name="${2:-}"
  [ -n "$_cl_provider" ] && [ -n "$_cl_name" ] || die "usage: agentic login <provider> <name> [--force]"
  shift 2

  _cl_force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) _cl_force=1 ;;
      *) die "unknown option for login: $1" ;;
    esac
    shift
  done

  validate_provider "$_cl_provider"
  validate_name "$_cl_name"
  load_provider "$_cl_provider"

  _cl_dir=$(account_dir "$_cl_provider" "$_cl_name")
  if [ -d "$_cl_dir" ] && [ "$_cl_force" -eq 0 ]; then
    die "account '$_cl_name' already exists - pass --force to replace it"
  fi

  ensure_account_dir "$_cl_provider" "$_cl_name"
  provider_login "$_cl_name" || die "login failed - '$_cl_name' was not changed"
  [ -f "$(provider_auth_artifact "$_cl_name")" ] || die "login did not create an auth.json for '$_cl_name'"
  activate_account "$_cl_provider" "$_cl_name"
}

cmd_use() {
  _cu_provider="${1:-}"
  _cu_name="${2:-}"
  [ -n "$_cu_provider" ] && [ -n "$_cu_name" ] || die "usage: agentic use <provider> <name> [--force]"
  shift 2

  _cu_force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) _cu_force=1 ;;
      *) die "unknown option for use: $1" ;;
    esac
    shift
  done

  validate_provider "$_cu_provider"
  validate_name "$_cu_name"
  [ -d "$(account_dir "$_cu_provider" "$_cu_name")" ] || die "no such account: $_cu_name"
  load_provider "$_cu_provider"
  [ -f "$(provider_auth_artifact "$_cu_name")" ] || die "'$_cu_name' has no auth.json - relogin first"

  _cu_live=$(provider_live_auth)
  _cu_active=$(get_active "$_cu_provider")
  if [ "$_cu_force" -eq 0 ] && [ -n "$_cu_active" ] && [ -f "$_cu_live" ] && [ ! -L "$_cu_live" ]; then
    die "live auth is no longer linked to '$_cu_active' (a bare login may have replaced it)
  repair it first, or pass --force to preserve it as a backup and switch"
  fi

  if [ "$_cu_force" -eq 0 ] && command -v provider_is_running >/dev/null 2>&1 && provider_is_running; then
    die "$_cu_provider is currently running (pid $(provider_running_pids))
  quit it first, or pass --force"
  fi

  activate_account "$_cu_provider" "$_cu_name"
}

cmd_relogin() {
  [ $# -eq 2 ] || die "usage: agentic relogin <provider> <name>"
  validate_provider "$1"
  validate_name "$2"
  [ -d "$(account_dir "$1" "$2")" ] || die "no such account: $2"
  cmd_login "$1" "$2" --force
}

auth_is_parseable() {
  if command -v jq >/dev/null 2>&1; then
    jq -e . "$1" >/dev/null 2>&1
    return
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$1" >/dev/null 2>&1
    return
  fi
  die "check requires jq or python3 to validate JSON"
}

cmd_check() {
  _cc_provider="${1:-}"
  _cc_name="${2:-}"
  [ -n "$_cc_provider" ] && [ -n "$_cc_name" ] || die "usage: agentic check <provider> <name> [--deep]"
  shift 2

  _cc_deep=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --deep) _cc_deep=1 ;;
      *) die "unknown option for check: $1" ;;
    esac
    shift
  done

  validate_provider "$_cc_provider"
  validate_name "$_cc_name"
  load_provider "$_cc_provider"
  _cc_auth=$(provider_auth_artifact "$_cc_name")
  [ -f "$_cc_auth" ] || die "'$_cc_name' has no auth.json"

  if auth_is_parseable "$_cc_auth"; then
    info "structure: valid"
  else
    warn "structure: invalid JSON"
    return 1
  fi

  if [ "$_cc_deep" -eq 1 ]; then
    if provider_status "$_cc_name"; then
      info "$_cc_provider: ok"
    else
      warn "$_cc_provider: status failed"
      return 1
    fi
  fi
}

repair_provider() {
  _rp_provider="$1"
  load_provider "$_rp_provider"
  _rp_live=$(provider_live_auth)
  _rp_active=$(get_active "$_rp_provider")

  [ -f "$_rp_live" ] && [ ! -L "$_rp_live" ] || return 0
  if [ -z "$_rp_active" ]; then
    warn "$_rp_provider live auth is a regular file but no account is active; leaving it in place"
    return 0
  fi
  if [ ! -d "$(account_dir "$_rp_provider" "$_rp_active")" ]; then
    warn "$_rp_provider active account '$_rp_active' is missing; leaving live auth in place"
    return 0
  fi

  activate_account "$_rp_provider" "$_rp_active"
  info "repaired $_rp_provider account '$_rp_active'"
}

cmd_repair() {
  _cr_provider=""
  while [ $# -gt 0 ]; do
    case "$1" in
      codex|cursor)
        [ -z "$_cr_provider" ] || die "repair takes at most one provider"
        _cr_provider="$1"
        ;;
      *) die "unknown option for repair: $1" ;;
    esac
    shift
  done

  if [ -n "$_cr_provider" ]; then
    repair_provider "$_cr_provider"
  else
    for _cr_each in $PROVIDER_LIST; do
      repair_provider "$_cr_each"
    done
  fi
}

cmd_rm() {
  _crm_provider="${1:-}"
  _crm_name="${2:-}"
  [ -n "$_crm_provider" ] && [ -n "$_crm_name" ] || die "usage: agentic rm <provider> <name> [--yes]"
  shift 2

  _crm_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) _crm_yes=1 ;;
      *) die "unknown option for rm: $1" ;;
    esac
    shift
  done

  validate_provider "$_crm_provider"
  validate_name "$_crm_name"
  _crm_dir=$(account_dir "$_crm_provider" "$_crm_name")
  [ -d "$_crm_dir" ] || die "no such account: $_crm_name"
  load_provider "$_crm_provider"

  if [ "$_crm_yes" -eq 0 ]; then
    printf "delete account '%s' and its saved credential? [y/N] " "$_crm_name"
    read -r _crm_reply || _crm_reply=""
    case "$_crm_reply" in
      y|Y|yes|YES) ;;
      *) info "cancelled"; return 0 ;;
    esac
  fi

  _crm_active=$(get_active "$_crm_provider")
  _crm_live=$(provider_live_auth)
  if [ "$_crm_active" = "$_crm_name" ]; then
    warn "active account '$_crm_name'; live auth link will be backed up and removed"
    if [ -L "$_crm_live" ] && [ -e "$_crm_live" ] && [ ! -e "$_crm_live.bak" ]; then
      cp -p "$_crm_live" "$_crm_live.bak" || die "backup failed"
      harden_auth_file "$_crm_live.bak"
    fi
    [ -L "$_crm_live" ] && rm -f "$_crm_live"
    clear_active "$_crm_provider"
  fi

  rm -rf "$_crm_dir"
  info "removed $_crm_name"
}

cmd_restore() {
  [ $# -eq 1 ] || die "usage: agentic restore <provider>"
  validate_provider "$1"
  load_provider "$1"
  _crs_live=$(provider_live_auth)
  [ -f "$_crs_live.bak" ] || die "no backup at $_crs_live.bak"
  rm -f "$_crs_live"
  cp -p "$_crs_live.bak" "$_crs_live" || die "restore failed"
  harden_auth_file "$_crs_live"
  clear_active "$1"
  info "restored $_crs_live from backup"
}

cmd_run() {
  _cr_provider="${1:-}"
  _cr_name="${2:-}"
  [ -n "$_cr_provider" ] && [ -n "$_cr_name" ] || die "usage: agentic run <provider> <name> [--] <args...>"
  shift 2
  [ "${1:-}" = "--" ] && shift

  validate_provider "$_cr_provider"
  validate_name "$_cr_name"
  [ -d "$(account_dir "$_cr_provider" "$_cr_name")" ] || die "no such account: $_cr_name"
  load_provider "$_cr_provider"

  while IFS= read -r _cr_assignment; do
    # Export the KEY=value assignment emitted by the provider.
    # shellcheck disable=SC2163
    [ -n "$_cr_assignment" ] && export "$_cr_assignment"
  done < <(provider_run_env "$_cr_name")

  exec "$(provider_cli_bin)" "$@"
}

# --------------------------------------------------------------------------
# shell-init - add or remove the shell integration
# --------------------------------------------------------------------------

AGENTIC_RC_MARK_START="# >>> agentic shell-init >>>"
AGENTIC_RC_MARK_END="# <<< agentic shell-init <<<"

shell_snippet_path() {
  printf '%s\n' "$AGENTIC_ROOT/shell/agentic.sh"
}

default_rcfile() {
  case "${SHELL##*/}" in
    zsh)  printf '%s\n' "${ZDOTDIR:-$HOME}/.zshrc" ;;
    bash) printf '%s\n' "$HOME/.bashrc" ;;
    *)    printf '%s\n' "$HOME/.profile" ;;
  esac
}

path_owner() {
  stat -f '%Su' "$1" 2>/dev/null && return 0
  stat -c '%U' "$1" 2>/dev/null && return 0
  # shellcheck disable=SC2012
  ls -ld "$1" 2>/dev/null | awk '{print $3; exit}'
}

rc_has_integration() {
  [ -f "$1" ] || return 1
  grep -qF "$AGENTIC_RC_MARK_START" "$1"
}

# Where to write when the rc file is a symlink (~/.zshrc -> ~/dotfiles/zshrc).
rc_write_target() {
  if [ -L "$1" ]; then
    resolve_path "$1"
  else
    printf '%s\n' "$1"
  fi
}

rc_add_integration() {
  _rai_rc="$1"
  _rai_write=$(rc_write_target "$_rai_rc")
  _rai_snippet=$(shell_snippet_path)

  [ -f "$_rai_snippet" ] || die "cannot find the shell snippet at $_rai_snippet"

  if rc_has_integration "$_rai_rc"; then
    info "shell integration already present in $_rai_rc"
    return 0
  fi

  if [ -e "$_rai_rc" ]; then
    if [ ! -w "$_rai_write" ]; then
      die "cannot write $_rai_rc - it is not writable by you
  owned by '$(path_owner "$_rai_write")', you are '$(id -un)'
  take ownership:
    sudo chown $(id -un) $_rai_write

  or use a different file:
    agentic shell-init --rc ~/.zprofile

  or add this line yourself:
    source \"$_rai_snippet\""
    fi
  else
    _rai_dir=$(dirname "$_rai_rc")
    mkdir -p "$_rai_dir" || die "cannot create $_rai_dir"
    [ -w "$_rai_dir" ] || die "cannot create $_rai_rc - $_rai_dir is not writable
  owned by '$(path_owner "$_rai_dir")', you are '$(id -un)'
  add this line yourself instead:
    source \"$_rai_snippet\""
  fi

  {
    printf '\n%s\n' "$AGENTIC_RC_MARK_START"
    # shellcheck disable=SC2016
    printf '# Intercepts `codex login`/`logout` and `agent login`/`logout`.\n'
    printf '# Remove with: agentic shell-init --remove\n'
    printf 'source "%s"\n' "$_rai_snippet"
    printf '%s\n' "$AGENTIC_RC_MARK_END"
  } >> "$_rai_rc" || die "cannot write $_rai_rc"

  info "${C_GREEN}added${C_RESET} shell integration to $_rai_rc"
  info "${C_DIM}active in new shells; for this one:  source $_rai_rc${C_RESET}"
}

rc_remove_integration() {
  _rri_rc="$1"
  if ! rc_has_integration "$_rri_rc"; then
    info "no shell integration in $_rri_rc"
    return 0
  fi

  _rri_write=$(rc_write_target "$_rri_rc")

  [ -w "$_rri_write" ] || die "cannot edit $_rri_rc - it is not writable by you
  owned by '$(path_owner "$_rri_write")', you are '$(id -un)'
  take ownership with:  sudo chown $(id -un) $_rri_write
  or delete the block between the agentic shell-init markers by hand"

  _rri_tmp="${_rri_write}.agentic.tmp"
  awk -v s="$AGENTIC_RC_MARK_START" -v e="$AGENTIC_RC_MARK_END" '
    $0 == s {
      if (blanks > 0) { blanks-- }
      skip = 1
      next
    }
    !skip {
      if ($0 == "") { blanks++ }
      else { while (blanks > 0) { print ""; blanks-- }; print }
    }
    $0 == e { skip = 0 }
    END { while (blanks > 0) { print ""; blanks-- } }
  ' "$_rri_rc" > "$_rri_tmp" || die "cannot rewrite $_rri_rc"
  mv "$_rri_tmp" "$_rri_write" || die "cannot replace $_rri_write"

  info "${C_GREEN}removed${C_RESET} shell integration from $_rri_rc"
}

cmd_shell_init() {
  rcfile=""; remove=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --remove) remove=1 ;;
      --rc)     shift; [ $# -gt 0 ] || die "--rc needs a file"; rcfile="$1" ;;
      --rc=*)   rcfile="${1#--rc=}" ;;
      --print)  shell_snippet_path; return 0 ;;
      *)        die "unknown option for shell-init: $1" ;;
    esac
    shift
  done

  [ -n "$rcfile" ] || rcfile=$(default_rcfile)

  if [ "$remove" -eq 1 ]; then
    rc_remove_integration "$rcfile"
  else
    rc_add_integration "$rcfile"
  fi
}

[ $# -gt 0 ] || { usage; exit 1; }

case "$1" in
  help|-h|--help)   usage ;;
  --version|-V)     print_version agentic ;;
  list)             shift; cmd_list "$@" ;;
  which)            shift; cmd_which "$@" ;;
  login)            shift; cmd_login "$@" ;;
  relogin)          shift; cmd_relogin "$@" ;;
  use)              shift; cmd_use "$@" ;;
  check)            shift; cmd_check "$@" ;;
  repair)           shift; cmd_repair "$@" ;;
  rm)               shift; cmd_rm "$@" ;;
  restore)          shift; cmd_restore "$@" ;;
  run)              shift; cmd_run "$@" ;;
  migrate)          shift; cmd_migrate "$@" ;;
  shell-init)       shift; cmd_shell_init "$@" ;;
  *)
    die "unknown command: $1 (try 'agentic --help')" ;;
esac
