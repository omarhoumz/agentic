#compdef agentic
#
# zsh completion for agentic. Candidates come from `agentic __complete`,
# which reads the command table; this file only adapts them to _describe.

_agentic() {
  local line
  local -a candidates
  for line in ${(f)"$(agentic __complete $(( CURRENT - 1 )) "${(@)words[2,CURRENT]}" 2>/dev/null)"}; do
    if [[ $line == __files__ ]]; then
      _files
      return
    fi
    candidates+=("$line")
  done
  (( ${#candidates} )) && _describe -t values 'agentic' candidates
}

_agentic "$@"
